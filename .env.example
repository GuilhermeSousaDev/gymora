# --- Database ---
# Local: docker compose (see docker-compose.yml)
DATABASE_URL=postgres://gymora:gymora@localhost:5434/gymora
# Supabase (Dashboard > Connect):
#   DATABASE_URL = "Transaction pooler" (port 6543) — used by the app
#   DIRECT_URL   = "Session pooler" (port 5432)     — used by migrations (drizzle-kit)
# DATABASE_URL="postgresql://postgres.<project>:<password>@<region>.pooler.supabase.com:6543/postgres?pgbouncer=true"
# DIRECT_URL="postgresql://postgres.<project>:<password>@<region>.pooler.supabase.com:5432/postgres"

# --- Auth (Better Auth, stored in the same Postgres) ---
# Generate with: openssl rand -base64 32
BETTER_AUTH_SECRET=change-me
BETTER_AUTH_URL=http://localhost:3000

# --- AI (any OpenAI-compatible provider; defaults to Groq free tier) ---
REMOTE_AI_BASE_URL=https://api.groq.com/openai/v1
REMOTE_AI_API_KEY=
REMOTE_AI_MODEL=openai/gpt-oss-120b
# Comma-separated, tried in order when the previous model is rate-limited / failing
REMOTE_AI_FALLBACKS=openai/gpt-oss-20b,qwen/qwen3.8-27b
# Model that accepts images (used for physique photo feedback)
REMOTE_AI_VISION_MODEL=qwen/qwen3.8-27b
REMOTE_AI_VISION_FALLBACKS=
